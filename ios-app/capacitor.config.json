{
  "appId": "website.amsterdamguestlistservice.app",
  "appName": "AGS",
  "webDir": "www",
  "backgroundColor": "#050505",
  "ios": {
    "contentInset": "never",
    "scheme": "AGS",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#050505", "showSpinner": false },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] },
    "StatusBar": { "style": "DARK", "backgroundColor": "#050505", "overlaysWebView": true }
  }
}
