{
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/about.html",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/api/legal?p=privacy" },
    { "source": "/privacy.html", "destination": "/api/legal?p=privacy" },
    { "source": "/terms", "destination": "/api/legal?p=terms" },
    { "source": "/terms.html", "destination": "/api/legal?p=terms" },
    { "source": "/support", "destination": "/api/legal?p=support" },
    { "source": "/support.html", "destination": "/api/legal?p=support" }
  ],
  "crons": [
    {
      "path": "/api/send-day-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/send-day-reminders",
      "schedule": "0 20 * * *"
    }
  ]
}
