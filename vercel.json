{
  "redirects": [
    {
      "source": "/about",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/about.html",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/announce-new",
      "destination": "/api/ags?fn=announce-new"
    },
    {
      "source": "/api/broadcast",
      "destination": "/api/ags?fn=broadcast"
    },
    {
      "source": "/api/admin-stats",
      "destination": "/api/ags?fn=admin-stats"
    },
    {
      "source": "/api/calendar",
      "destination": "/api/ags?fn=calendar"
    },
    {
      "source": "/api/delete-account",
      "destination": "/api/ags?fn=delete-account"
    },
    {
      "source": "/api/notify-report",
      "destination": "/api/ags?fn=notify-report"
    },
    {
      "source": "/api/report-action",
      "destination": "/api/ags?fn=report-action"
    },
    {
      "source": "/privacy",
      "destination": "/api/ags?fn=legal&p=privacy"
    },
    {
      "source": "/privacy.html",
      "destination": "/api/ags?fn=legal&p=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/ags?fn=legal&p=terms"
    },
    {
      "source": "/terms.html",
      "destination": "/api/ags?fn=legal&p=terms"
    },
    {
      "source": "/support",
      "destination": "/api/ags?fn=legal&p=support"
    },
    {
      "source": "/support.html",
      "destination": "/api/ags?fn=legal&p=support"
    }
  ],
  "crons": [
    {
      "path": "/api/send-day-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/send-day-reminders",
      "schedule": "0 19 * * *"
    }
  ]
}
